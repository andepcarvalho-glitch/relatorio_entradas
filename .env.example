# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado.

# Banco ODS onde fica a view v_EntradaNotas (mesmo banco usado por
# consulta_nfs_nacional para o confronto de lançamentos).
ODS_DB_HOST=
ODS_DB_NAME=
ODS_DB_USER=
ODS_DB_PASSWORD=

# E-mail usado para enviar o relatorio de divergencias (senha de app do
# Gmail, nao a senha normal da conta - gere em myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESTINATARIO=
